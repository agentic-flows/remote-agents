{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remote-agents",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "basic"
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "remote-agents-workspaces",
      "binding": "R2_BUCKET"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      },
      {
        "class_name": "Orchestrator",
        "name": "Orchestrator"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox", "Orchestrator"],
      "tag": "v1"
    },
    {
      "deleted_classes": ["Orchestrator"],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": ["Orchestrator"],
      "tag": "v3"
    }
  ]
}
